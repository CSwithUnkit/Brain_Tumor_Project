{
  "name": "Brain Tumor Project (Python 3.12)",
  // More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "dashboard/app.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // CPU-only torch first (small wheel), then the rest of requirements.
  "postCreateCommand": "pip3 install --user torch torchvision --index-url https://download.pytorch.org/whl/cpu && [ -f requirements.txt ] && pip3 install --user -r requirements.txt && echo '✅ Requirements installed'",
  "postAttachCommand": {
    "server": "streamlit run dashboard/app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
